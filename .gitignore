# Secrets
.env
.env.*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# Built by scripts/bootstrap_cowork_deps.sh on a Cowork device VM.
.cowork-deps/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Build artifacts
build/
dist/
*.egg

# Local-only
*.local.*
scratch/

# Personal pipeline config — search preferences (metros, weights, titles).
# The committed template is config/pipeline.example.toml.
config/pipeline.toml

# ALL local data: state.db (companies, ledgers, digest archive), the ephemeral
# jobs.db, fill audits, outreach log. Nothing under data/ or digests/ is ever
# committed — the pipeline runs locally and the repo carries no personal data.
data/
digests/

# Personal profile — identity, EEO answers, driving docs. The committed
# template lives in profile.example/. Never commit the real thing.
profile/


# Playwright MCP session artifacts
.playwright-mcp/

# Ephemeral session state — may contain debugging notes / PII; do not publish
session-context.md

# Transfer archives. A staged copy of this repo contains the gitignored
# profile/ directory, so an untracked tarball in the root is a PII leak one
# `git add -A` away. Cowork writes these when it stages source for its cloud
# container.
*.tgz
*.tar.gz
*.zip
_transfer_*
