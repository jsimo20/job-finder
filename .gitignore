# Secrets
.env
.env.*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Build artifacts
build/
dist/
*.egg

# Local-only
*.local.*
scratch/

# Personal pipeline config — search preferences (metros, weights, titles).
# The committed template is config/pipeline.example.toml; CI receives the
# real config via the PIPELINE_CONFIG Actions variable.
config/pipeline.toml

# Personal profile — identity, EEO answers, driving docs. The committed
# template lives in profile.example/. Never commit the real thing.
profile/

# Generated database (rebuilt by pipeline)
data/jobs.db

# Playwright MCP session artifacts
.playwright-mcp/

# Ephemeral session state — may contain debugging notes / PII; do not publish
session-context.md

# Outreach log — third-party contact names (PII); local-only, do not publish
data/outreach.jsonl

# Captured form-fill inventories — the value column holds contact details.
# Redact via form_inventory.redact() before promoting one to tests/fixtures/.
data/fill_audits/
